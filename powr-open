#!/usr/bin/env python3
"""The program the system runs for a web link while Herdr links is on.

A desktop's own "open the browser" key also runs it, with no link, or with
flags of its own; only the first thing that looks like a link is passed on.
"""
import os
import sys
from pathlib import Path

bridge = Path(__file__).resolve().parent / "bridge.py"
links = [arg for arg in sys.argv[1:] if not arg.startswith("-")]
os.execv(sys.executable, [sys.executable, str(bridge), "--app", "handle-link", links[0] if links else ""])
